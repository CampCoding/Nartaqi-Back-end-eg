{
  "info": {
    "name": "Admin Rounds API Collection",
    "description": "Complete CRUD operations for rounds management with Arabic responses",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    }
