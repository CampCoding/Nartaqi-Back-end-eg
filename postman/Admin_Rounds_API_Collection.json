  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set base URL if not already set",
          "if (!pm.environment.get('base_url')) {",
          "    pm.environment.set('base_url', 'http://127.0.0.1:8000/api');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Log response for debugging",
          "console.log('Response Status:', pm.response.status);",
          "console.log('Response Body:', pm.response.text());",
          "",
          "// Check if response is successful",
          "pm.test('Status code is successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});",
          "",
          "// Check if response has Arabic message",
          "if (pm.response.json() && pm.response.json().message) {",
          "    pm.test('Response has Arabic message', function () {",
          "        pm.expect(pm.response.json().message).to.be.a('string');",
          "    });",
          "}"
        ]
      }
    }
  ]
}
