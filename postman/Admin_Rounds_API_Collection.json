  "item": [
    {
      "name": "Admin Rounds Management",
      "item": [
        {
          "name": "Get All Rounds",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/rounds?per_page=10&page=1",
              "host": ["{{base_url}}"],
              "path": ["admin", "rounds"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Number of items per page"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "course_category_id",
                  "value": "",
                  "description": "Filter by course category ID (optional)"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Filter by status: 0=inactive, 1=active (optional)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search by round name (optional)"
                }
              ]
            },
            "description": "Get all rounds with pagination and filtering options"
          },
          "response": []
        },
        {
